{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Web Demo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect-brk", "${workspaceFolder}/dist/web-demo/server.js"],
      "env": {
        "PORT": "4318"
      },
      "preLaunchTask": "npm: build",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Story Video Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/story-video-server",
      "preLaunchTask": "npm: chrome:debug",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "4388",
        "PATH": "${env:HOME}/.local/bin:${env:PATH}"
      },
      "console": "integratedTerminal"
    }
  ]
}
